{
  "name": "every-org-donation-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Internal dashboard for manually processing Every.org donations.",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch backend/src/index.ts",
    "dev:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0 --port 5173",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p backend/tsconfig.json",
    "build:client": "npm --prefix frontend run build",
    "start": "node backend/dist/index.js",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && npm --prefix frontend exec tsc -- -p frontend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2"
  }
}
